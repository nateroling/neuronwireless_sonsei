From 2f852bc14274a8b0a0a857a125938f8741aa5ee2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 14:53:59 +0000
Subject: [PATCH] KeyRoleManager: per-Superkey hold-on-other-key-press setting

Adds a KEYROLE_EXT config item with one bit per Superkey slot, and the
Focus command superkeys.holdOnOtherKey to read it (one 0/1 per slot)
or write it (0/1 values from slot 0; slots not given keep their value).

Qukeys asks superkey_hold_on_other_key_press() for the Superkey a
qukey was made from, so each tap-hold Superkey can opt in or out.
Erased flash reads as all 1s, so every Superkey keeps today's behavior
until it is changed. The item is separate from keyrole_config_t so the
stock config layout is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013er8HvVx2UQptRCtTJmM6t
---
 src/kaleidoscope/plugin/KeyRoleManager.cpp   | 68 ++++++++++++++++++++
 src/kaleidoscope/plugin/KeyRoleManager.h     | 22 +++++++
 src/kaleidoscope/plugin/SuperkeysHandler.cpp |  2 +-
 3 files changed, 91 insertions(+), 1 deletion(-)

diff --git a/src/kaleidoscope/plugin/KeyRoleManager.cpp b/src/kaleidoscope/plugin/KeyRoleManager.cpp
index c44768f..351af68 100644
--- a/src/kaleidoscope/plugin/KeyRoleManager.cpp
+++ b/src/kaleidoscope/plugin/KeyRoleManager.cpp
@@ -22,6 +22,7 @@
 #include "kaleidoscope/key_defs.h"
 #include <Kaleidoscope-FocusSerial.h>
 #include <cstdint>
+#include <cstring>
 
 #include "EEPROMKeymapDygma.h"
 #include "QukeysDygma.h"
@@ -338,6 +339,9 @@ EventHandlerResult KeyRoleManager::onSetup()
     result = kbdfal_ll_memory_item_request( KBDMEM_ITEM_TYPE_KEYROLE, (const void **)&p_keyrole_config );
     ASSERT_DYGMA( result == RESULT_OK, "kbdfal_ll_memory_item_request failed" );
 
+    result = kbdfal_ll_memory_item_request( KBDMEM_ITEM_TYPE_KEYROLE_EXT, (const void **)&p_keyrole_ext_config );
+    ASSERT_DYGMA( result == RESULT_OK, "kbdfal_ll_memory_item_request failed" );
+
     set_active_sk();
     determine_key_role();
     return EventHandlerResult::OK;
@@ -641,10 +645,74 @@ EventHandlerResult KeyRoleManager::onFocusEvent(const char *command)
         }
         result = EventHandlerResult::EVENT_CONSUMED;
     }
+    else if (strcmp_P(command + 10, "holdOnOtherKey") == 0)
+    {
+        // Read: one 0/1 per Superkey slot, in slot order.
+        // Write: 0/1 values from slot 0 on; slots not given keep their value.
+        if (::Focus.isEOL())
+        {
+            send_hold_on_other_key_press_map();
+        }
+        else
+        {
+            read_hold_on_other_key_press_map();
+        }
+        result = EventHandlerResult::EVENT_CONSUMED;
+    }
 
     return result;
 }
 
+bool KeyRoleManager::superkey_hold_on_other_key_press(uint16_t sk_id) const
+{
+    if (p_keyrole_ext_config == nullptr || IS_OUTSIDE_DYNAMIC_SUPER_RANGE(sk_id))
+    {
+        return true;
+    }
+
+    uint16_t index = sk_id - ranges::DYNAMIC_SUPER_FIRST;
+
+    return (p_keyrole_ext_config->hold_on_other_key_press[index / 8] >> (index % 8)) & 0x01;
+}
+
+void KeyRoleManager::send_hold_on_other_key_press_map()
+{
+    for (uint16_t i = 0; i < Utils::SUPER_KEY_COUNT; ++i)
+    {
+        ::Focus.send(uint8_t(superkey_hold_on_other_key_press(ranges::DYNAMIC_SUPER_FIRST + i) ? 1 : 0));
+    }
+}
+
+void KeyRoleManager::read_hold_on_other_key_press_map()
+{
+    uint8_t bits[sizeof(p_keyrole_ext_config->hold_on_other_key_press)];
+    uint16_t pos = 0;
+
+    memcpy(bits, p_keyrole_ext_config->hold_on_other_key_press, sizeof(bits));
+
+    while (!::Focus.isEOL() && pos < Utils::SUPER_KEY_COUNT)
+    {
+        uint8_t enabled;
+        ::Focus.read(enabled);
+
+        if (enabled)
+        {
+            bits[pos / 8] |= (1 << (pos % 8));
+        }
+        else
+        {
+            bits[pos / 8] &= ~(1 << (pos % 8));
+        }
+
+        pos++;
+    }
+
+    result_t result = kbdfal_ll_memory_data_save( p_keyrole_ext_config->hold_on_other_key_press, bits, sizeof(bits) );
+    ASSERT_DYGMA( result == RESULT_OK, "hold_on_other_key_press save failed" );
+
+    UNUSED( result );
+}
+
 EventHandlerResult KeyRoleManager::beforeReportingState()
 {
     if (qukeys.beforeReportingState() == EventHandlerResult::EVENT_CONSUMED)
diff --git a/src/kaleidoscope/plugin/KeyRoleManager.h b/src/kaleidoscope/plugin/KeyRoleManager.h
index 0e049d7..82513c2 100644
--- a/src/kaleidoscope/plugin/KeyRoleManager.h
+++ b/src/kaleidoscope/plugin/KeyRoleManager.h
@@ -40,6 +40,18 @@ class KeyRoleManager : public kaleidoscope::Plugin
         Superkey::superkey_config_t superkeys[Utils::SUPER_KEY_COUNT];
     } keyrole_config_t;
 
+    // Per-Superkey options added by this fork. A separate config item, placed
+    // after every stock item in the config cache, so the stock layout (and
+    // everyone's saved layers and settings) is untouched.
+    typedef struct PACK
+    {
+        // One bit per Superkey (bit i % 8 of byte i / 8). 1 = when this
+        // Superkey works as a tap-hold key, it takes its HOLD action as soon
+        // as another key is pressed. Erased flash reads as all 1s, which
+        // keeps the behavior every Superkey had before this setting existed.
+        uint8_t hold_on_other_key_press[(Utils::SUPER_KEY_COUNT + 7) / 8];
+    } keyrole_ext_config_t;
+
   public:
 
     struct modified_keys_t
@@ -129,9 +141,19 @@ class KeyRoleManager : public kaleidoscope::Plugin
 
     modified_keys_t* get_configured_qukeys(uint16_t qukey_id);
 
+    /**
+     * @brief Whether a Superkey uses hold-on-other-key-press.
+     * @param sk_id The Superkey's Key value (ranges::DYNAMIC_SUPER_FIRST + index).
+     */
+    bool superkey_hold_on_other_key_press(uint16_t sk_id) const;
+
   private:
 
     const keyrole_config_t * p_keyrole_config = nullptr;
+    const keyrole_ext_config_t * p_keyrole_ext_config = nullptr;
+
+    void send_hold_on_other_key_press_map();
+    void read_hold_on_other_key_press_map();
 
     // Current qukey mappings (superkey_id -> qukey_id)
     modified_keys_t modified_keys[Utils::MAX_SUPER_KEYS_ACTIVE];
diff --git a/src/kaleidoscope/plugin/SuperkeysHandler.cpp b/src/kaleidoscope/plugin/SuperkeysHandler.cpp
index e151b04..8a368c9 100644
--- a/src/kaleidoscope/plugin/SuperkeysHandler.cpp
+++ b/src/kaleidoscope/plugin/SuperkeysHandler.cpp
@@ -399,7 +399,7 @@ EventHandlerResult SuperkeysHandler::beforeReportingState()
 
 EventHandlerResult SuperkeysHandler::onFocusEvent(const char *command)
 {
-    if (::Focus.handleHelp(command, "superkeys.map\nsuperkeys.waitfor\nsuperkeys.timeout\nsuperkeys.repeat\nsuperkeys.holdstart\nsuperkeys.overlap"))
+    if (::Focus.handleHelp(command, "superkeys.map\nsuperkeys.waitfor\nsuperkeys.timeout\nsuperkeys.repeat\nsuperkeys.holdstart\nsuperkeys.overlap\nsuperkeys.holdOnOtherKey"))
         return EventHandlerResult::OK;
 
     if (strncmp_P(command, "superkeys.", 10) != 0) return EventHandlerResult::OK;
